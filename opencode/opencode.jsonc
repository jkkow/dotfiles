{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-terra",
  "default_agent": "plan",
  "instructions": [
    "AGENTS.md"
  ],
  "mcp": {
    "solidcraft": {
      "type": "local",
      "command": [
        "C:\\Users\\jkkow\\.local\\opt\\solidcraft-0.30.0-windows-x64-portable\\solidcraft-cli.exe",
        "mcp",
        "--allow-path",
        "C:\\Users\\jkkow\\Downloads"
      ],
      "enabled": true,
      "timeout": 330000
    },
    "freecad": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "C:\\Users\\jkkow\\.local\\opt\\mcp\\freecad-mcp",
        "run",
        "freecad-mcp"
      ]
    }
  }
}
