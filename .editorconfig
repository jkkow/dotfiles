root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ps1,psm1,psd1,ahk}]
indent_style = space
indent_size = 4

[*.lua]
indent_style = tab
indent_size = 4

[*.{md,yml,yaml,json,toml}]
indent_style = space
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf
